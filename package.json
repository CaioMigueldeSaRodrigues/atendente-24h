{
  "name": "atendente-24h",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:llm:live": "npm run build && node --env-file-if-exists=.env.local dist/integrations/llm/run-live-smoke.js",
    "test:e2e": "tsc -p tsconfig.test.json && node dist-test/tests/e2e/run-gate.js",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/tests/unit/*.test.js",
    "build": "tsc",
    "start:basic": "node --env-file-if-exists=.env.local dist/app/run-basic-plan.js",
    "migrate:postgres": "npm run build && node --env-file-if-exists=.env.local dist/infrastructure/postgres/migrate-postgres.js",
    "check:postgres": "npm run build && node --env-file-if-exists=.env.local dist/infrastructure/postgres/check-postgres-connection.js",
    "transfer:postgres": "npm run build && node --env-file-if-exists=.env.local dist/infrastructure/postgres/transfer-sqlite-to-postgres.js",
    "test:postgres": "tsc -p tsconfig.test.json && node --test dist-test/tests/integration/postgres-migration.test.js",
    "preview:operator": "node dist/app/run-operator-preview.js"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "2.51.0",
    "openai": "^7.22.0",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
